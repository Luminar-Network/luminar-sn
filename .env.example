BITTENSOR_NETWORK=finney
LUMINAR_NETUID=87

LUMINAR_BACKEND_URL=http://localhost:8000

LUMINAR_HTTP_TIMEOUT=30
LUMINAR_VALIDATOR_POLL_INTERVAL=60

LUMINAR_WEIGHT_INTERVAL_BLOCKS=360
LUMINAR_WEIGHT_MONITOR_INTERVAL=300

LOG_LEVEL=DEBUG
LUMINAR_LOG_DIR=logs
LUMINAR_LOG_FILE_ENABLED=true
LOG_FILENAME=luminar_vali.log

LUMINAR_BEST_AGENT_DIR=.luminar_cache/best_agent
LUMINAR_BEST_AGENT_POLL_INTERVAL=60

LUMINAR_SANDBOX_IMAGE=luminar-sandbox:latest
LUMINAR_SANDBOX_WORKDIR=/tmp/luminar_sandbox

PLAGIARISM_THRESHOLD = 0.95

SETUP_TIMEOUT = 10 * 60
INFER_TIMEOUT = 25 * 60

MEMORY_LIMIT=16g
BURN_MODE=true
